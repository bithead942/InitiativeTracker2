{
  "name": "initiativetracker2",
  "version": "2.0.0",
  "description": "D&D Initiative Tracker 2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "dnd",
    "initiative",
    "tracker"
  ],
  "author": "bithead942",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bithead942.initiativetracker2",
    "productName": "InitiativeTracker2",
    "win": {
      "target": "portable",
      "icon": "assets/app-icon.ico",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "player.html",
      "player.js",
      "player.css",
      "styles.css",
      "package.json",
      "assets/**/*",
      "img/**/*"
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  }
}
